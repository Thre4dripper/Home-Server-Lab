# Template for secret.yaml. Copy it, fill in real values, then seal:
#
#   cp secret.yaml.example secret.yaml
#   # generate the three random values (see below), edit them in
#   ./setup.sh seal          # -> writes sealedsecret.yaml, safe to commit
#
# secret.yaml itself is gitignored (.gitignore:11). Keep it locally so you can
# re-seal after a sealed-secrets key rotation; never commit it.
#
# Generate the three random secrets with:
#   openssl rand -base64 32
#
# Notes on each value:
#   FILEBROWSER_ADMIN_PASSWORD    First-boot password for the `admin` user
#                                 (auth.adminUsername). Change it in the UI
#                                 after first login; this value stays as the
#                                 reset-to-known-state escape hatch.
#                                 Must be >= 12 chars to satisfy
#                                 auth.methods.password.minLength.
#
#   FILEBROWSER_JWT_TOKEN_SECRET  Signs session JWTs (auth.key). Rotating it
#                                 logs every user out and invalidates every
#                                 issued API token and WebDAV credential.
#
#   FILEBROWSER_TOTP_SECRET       Encrypts stored TOTP secrets at rest
#                                 (auth.totpSecret). Rotating it invalidates
#                                 every enrolled authenticator app — users must
#                                 re-enroll. Back this one up.
#
#   FILEBROWSER_ONLYOFFICE_SECRET Shared HMAC secret between FileBrowser and
#                                 OnlyOffice. BOTH pods read this same key, so
#                                 they cannot drift. Required even while
#                                 OnlyOffice sits at replicas: 0 — the
#                                 FileBrowser pod will not start without it.
apiVersion: v1
kind: Secret
metadata:
  name: filebrowser-quantum-secret
  namespace: file-management
type: Opaque
stringData:
  FILEBROWSER_ADMIN_PASSWORD: "CHANGE_ME_min_12_chars"
  FILEBROWSER_JWT_TOKEN_SECRET: "CHANGE_ME_openssl_rand_base64_32"
  FILEBROWSER_TOTP_SECRET: "CHANGE_ME_openssl_rand_base64_32"
  FILEBROWSER_ONLYOFFICE_SECRET: "CHANGE_ME_openssl_rand_base64_32"
